# Sao chép thành .env rồi điền giá trị. Không commit file .env.

# --- Database (docker compose) ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public

# --- API (apps/api) ---
PORT=3001
# Origin của web được phép gọi API (CORS), nhiều giá trị cách nhau bằng dấu phẩy
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=doi-gia-tri-nay
JWT_EXPIRES_IN=1d

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- VNPay sandbox (FR-21, tùy chọn) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return
