@startuml erd
title BrewLite - ERD
hide circle
skinparam linetype ortho

entity users { * id : int <<PK>>\n--\n email : varchar <<UNIQUE>>\n name : varchar\n password_hash : varchar\n role : enum\n points : int }
entity products { * id : int <<PK>>\n--\n name : varchar\n description : text\n base_price : int\n category : varchar\n image_url : varchar }
entity toppings { * id : int <<PK>>\n--\n name : varchar\n price : int }
entity promotions { * id : int <<PK>>\n--\n code : varchar <<UNIQUE>>\n type : enum\n value : int\n min_order : int\n expires_at : timestamp }
entity orders { * id : int <<PK>>\n--\n user_id : int <<FK>>\n promotion_id : int <<FK, null>>\n status : enum\n subtotal : int\n discount : int\n total : int\n created_at : timestamp }
entity order_items { * id : int <<PK>>\n--\n order_id : int <<FK>>\n product_id : int <<FK>>\n quantity : int\n size : varchar\n unit_price : int }
entity order_item_toppings { * order_item_id : int <<PK, FK>>\n * topping_id : int <<PK, FK>>\n--\n quantity : int\n price : int }
entity payments { * id : int <<PK>>\n--\n order_id : int <<FK>>\n user_id : int <<FK>>\n method : enum\n status : enum\n amount : int\n idempotency_key : varchar\n -- UNIQUE(user_id, idempotency_key) }
entity loyalty_transactions { * id : int <<PK>>\n--\n user_id : int <<FK>>\n order_id : int <<FK>>\n type : enum\n points : int\n -- UNIQUE(order_id, type) }

users ||--o{ orders
users ||--o{ payments
users ||--o{ loyalty_transactions
promotions |o--o{ orders
orders ||--|{ order_items
orders ||--o{ payments
orders ||--o{ loyalty_transactions
products ||--o{ order_items
order_items ||--o{ order_item_toppings
toppings ||--o{ order_item_toppings
@enduml