$f = Join-Path (Get-Location) "docs\diagrams\erd.puml"
$lines = [System.IO.File]::ReadAllLines($f)
$i = ($lines | Select-String -Pattern '^users ' | Select-Object -First 1).LineNumber - 1
$head = $lines[0..($i-1)]
$rels = @(
'users ||--o{ orders',
'users ||--o{ payments',
'users ||--o{ loyalty_transactions',
'users ||--o{ reward_redemptions',
'promotions |o--o{ orders',
'orders ||--|{ order_items',
'orders ||--o{ payments',
'orders |o--o{ loyalty_transactions',
'orders ||--o{ order_ingredient_uses',
'orders ||--o{ payment_intents',
'products ||--o{ order_items',
'order_items ||--o{ order_item_toppings',
'toppings ||--o{ order_item_toppings',
'products ||--o{ recipe_items',
'toppings ||--o{ topping_recipe_items',
'ingredients ||--o{ recipe_items',
'ingredients ||--o{ topping_recipe_items',
'ingredients ||--o{ order_ingredient_uses',
'payment_accounts |o--o{ payment_intents',
'rewards ||--o{ reward_redemptions',
'@enduml'
)
[System.IO.File]::WriteAllLines($f, ($head + $rels), (New-Object System.Text.UTF8Encoding $false))